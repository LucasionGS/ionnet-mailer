# Ionnet Mailer — Postfix main.cf (values marked "set by entrypoint" come from the environment)
compatibility_level = 3.10
# Written to the shared mail-logs volume so the app can build its mail log from it;
# the entrypoint also copies it to stdout for `docker compose logs postfix`.
maillog_file = /var/log/mail/postfix.log
# Long queue ids never repeat, so the app can key its mail log on them.
enable_long_queue_ids = yes
queue_directory = /var/spool/postfix
command_directory = /usr/sbin
daemon_directory = /usr/lib/postfix/sbin
data_directory = /var/lib/postfix
mail_owner = postfix
setgid_group = postdrop
inet_interfaces = all
inet_protocols = ipv4
biff = no
append_dot_mydomain = no
readme_directory = no
message_size_limit = 52428800
mailbox_size_limit = 0
recipient_delimiter = +
delay_warning_time = 4h
smtp_host_lookup = dns, native
lmtp_host_lookup = dns, native

# ---- Identity (set by entrypoint) -------------------------------------------
myhostname = mail.example.com
myorigin = $myhostname
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128 172.28.0.0/24
alias_maps =
alias_database =
local_recipient_maps =
local_transport = error:local mail delivery is disabled

# ---- Virtual domains / mailboxes / aliases from PostgreSQL ------------------
virtual_mailbox_domains = proxy:pgsql:/etc/postfix/sql/domains.cf
virtual_mailbox_maps = proxy:pgsql:/etc/postfix/sql/mailboxes.cf
virtual_alias_maps = proxy:pgsql:/etc/postfix/sql/aliases.cf
virtual_transport = lmtp:inet:dovecot:24
lmtp_tls_security_level = none

# ---- SASL via Dovecot -------------------------------------------------------
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname
broken_sasl_auth_clients = yes
smtpd_sender_login_maps = proxy:pgsql:/etc/postfix/sql/sender-login.cf

# ---- TLS (certificates copied in by tls-sync) --------------------------------
smtpd_tls_cert_file = /certs/tls.crt
smtpd_tls_key_file = /certs/tls.key
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
tls_preempt_cipherlist = no

# ---- Header checks ----------------------------------------------------------
# Logs each Subject so the admin mail log can show it (cleanup_submission has its own file).
header_checks = regexp:/etc/postfix/header_checks

# ---- rspamd milter ----------------------------------------------------------
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = accept
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# ---- Restrictions -----------------------------------------------------------
smtpd_helo_required = yes
smtpd_delay_reject = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
# With smtpd_delay_reject every list runs at RCPT TO, in the order client, helo, sender,
# relay, recipient. The client, HELO and sender checks live in the recipient list so that
# relay attempts (bots probing for an open relay) hit reject_unauth_destination first and
# get a permanent "Relay access denied" instead of a 4xx that invites a retry.
smtpd_client_restrictions =
smtpd_helo_restrictions =
smtpd_sender_restrictions =
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unlisted_recipient,
    reject_unknown_reverse_client_hostname,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain
smtpd_data_restrictions = reject_unauth_pipelining

# ---- Abuse limits (anvil) ---------------------------------------------------
anvil_rate_time_unit = 60s
smtpd_client_connection_rate_limit = 60
smtpd_client_connection_count_limit = 20
smtpd_client_auth_rate_limit = 10
smtpd_client_new_tls_session_rate_limit = 60
smtpd_client_event_limit_exceptions = $mynetworks
smtpd_soft_error_limit = 5
smtpd_hard_error_limit = 10

# ---- Outbound policy --------------------------------------------------------
smtp_helo_name = $myhostname
smtp_dns_support_level = enabled
relayhost =
