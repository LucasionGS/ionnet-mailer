{
  "name": "@ionnet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --no-warnings src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --experimental-strip-types --no-warnings src/seed.ts",
    "migrate": "node --experimental-strip-types --no-warnings src/db/migrate.ts",
    "migrate:create": "node --experimental-strip-types --no-warnings src/db/migrate.ts create"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@ionnet/shared": "workspace:*",
    "@node-rs/bcrypt": "^1.10.7",
    "hono": "^4.13.0",
    "imapflow": "^1.7.8",
    "ioredis": "^5.8.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.16.0",
    "postal-mime": "^3.0.0",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/imapflow": "^1.0.25",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
