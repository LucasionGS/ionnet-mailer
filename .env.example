# ---- Ionnet Mailer configuration ---------------------------------------
# Copy to .env and fill in. Every secret can be generated with: openssl rand -hex 32

# Public hostname of this server. Must have an A record pointing at this VPS
# and a PTR (reverse DNS) record set at your provider pointing back to it.
MAIL_HOSTNAME=mail.example.com

# Email address used by Caddy for Let's Encrypt account registration.
ACME_EMAIL=admin@example.com

# PostgreSQL. The app, Postfix and Dovecot all connect to this database.
POSTGRES_DB=ionmailer
POSTGRES_USER=ionmailer
POSTGRES_PASSWORD=change-me
# Read-only roles used by Postfix and Dovecot (created on first boot).
MAIL_DB_PASSWORD=change-me-too

# Dovecot master user: lets the web app open any mailbox without knowing the
# user's password. Keep this secret.
DOVECOT_MASTER_PASSWORD=change-me-three

# rspamd controller password (used by the app to read spam statistics).
RSPAMD_PASSWORD=change-me-four

# Secret used to sign session cookies.
APP_SECRET=change-me-five

# Optional antivirus. Requires `docker compose --profile clamav up -d`
# and roughly 3-4 GB of RAM for the ClamAV container.
CLAMAV_ENABLED=0

# Internal Docker network for the stack. Postfix and Dovecot trust this range.
MAIL_NETWORK_SUBNET=172.28.0.0/24

# How long the admin area keeps sign-in attempts and the mail log (the audit
# log is kept for at least a year).
ACTIVITY_RETENTION_DAYS=90
